#!/usr/bin/env bash
# ==============================================================================
# prism-disable — remove PRISM services: stop the daemons, drop proxy environment,
# and clean up trust databases.
# ==============================================================================
set -euo pipefail

CA_DIR="$HOME/.local/share/prism/ca"
ENV_FILE="$HOME/.config/environment.d/10-prism.conf"
NSS_NICKNAME="PRISM Local CA"
BLOCK_START="# >>> PRISM DEFAULT LLM PROXY >>>"
BLOCK_END="# <<< PRISM DEFAULT LLM PROXY <<<"
INIT_START="# PRISM — transparent LLM proxy (added by \`prism init --global\`)"
INIT_END="# end PRISM"
ENV_START="# PRISM environment (added by \`prism init --global\`)"

echo "[*] Disabling PRISM background services..."

# 1. Stop and disable the user services.
for svc in prism-proxy.service prism-mcp.service; do
    if systemctl --user is-active --quiet "$svc" 2>/dev/null; then
        systemctl --user stop "$svc" 2>/dev/null || true
    fi
    if systemctl --user is-enabled --quiet "$svc" 2>/dev/null; then
        systemctl --user disable "$svc" 2>/dev/null || true
    fi
    rm -f "$HOME/.config/systemd/user/$svc"
done
systemctl --user daemon-reload 2>/dev/null || true
echo "  ✓ Stopped & disabled prism-proxy and prism-mcp."

# 2. Remove the session environment file and unset systemd variables.
if [ -f "$ENV_FILE" ]; then
    rm -f "$ENV_FILE"
    echo "  ✓ Removed $ENV_FILE"
fi
systemctl --user unset-environment HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy PRISM_HUB_URL 2>/dev/null || true

# 3. Clean the shell rc blocks.
for RC in "$HOME/.bashrc" "$HOME/.profile" "$HOME/.zshrc"; do
    if [ -f "$RC" ]; then
        sed -i "/$BLOCK_START/,/$BLOCK_END/d" "$RC"
        sed -i "\|$INIT_START|,/$INIT_END/d" "$RC"
        sed -i "\|$ENV_START|,/$INIT_END/d" "$RC"
        echo "  ✓ Cleaned $RC"
    fi
done

# 4. Remove the CA from NSS databases.
if command -v certutil > /dev/null 2>&1; then
    count=0
    dbs=""
    [ -d "$HOME/.pki/nssdb" ] && dbs="sql:$HOME/.pki/nssdb"
    for prof in "$HOME"/.mozilla/firefox/*/ "$HOME"/snap/firefox/common/.mozilla/firefox/*/; do
        [ -f "${prof}cert9.db" ] && dbs="$dbs sql:${prof%/}"
    done
    for db in $dbs; do
        if certutil -D -d "$db" -n "$NSS_NICKNAME" -f /dev/null > /dev/null 2>&1; then
            count=$((count + 1))
        fi
    done
    echo "  ✓ NSS trust: removed from $count database(s)"
fi

cat << SUMMARY

==========================================================================
  [✓] PRISM background services disabled and cleaned.

  If this shell still has old exports active, run:
    unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy NODE_EXTRA_CA_CERTS SSL_CERT_FILE REQUESTS_CA_BUNDLE CURL_CA_BUNDLE
==========================================================================
SUMMARY
