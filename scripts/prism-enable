#!/usr/bin/env bash
# ==============================================================================
# prism-enable — enable PRISM background proxy and MCP services on this laptop.
#
# Safe architecture:
#   * Background proxy daemon runs under systemd user session (localhost:27181).
#   * MCP server runs under systemd user session (localhost:27182).
#   * Global HTTP_PROXY/HTTPS_PROXY are NEVER placed in environment.d or shell rc
#     to prevent breaking desktop IDEs (VS Code, Claude Code, Antigravity) if
#     the proxy is stopped or rebooting.
#   * Commands can be run through the proxy via `prism proxy <cmd>` or
#     temporarily in a shell via `eval $(prism proxy env)`.
# ==============================================================================
set -euo pipefail

CA_DIR="$HOME/.local/share/prism/ca"
CA_PATH="$CA_DIR/ca.crt"
BUNDLE_PATH="$CA_DIR/ca-bundle.crt"
ENV_FILE="$HOME/.config/environment.d/10-prism.conf"
PORT="27181"
MCP_PORT="27182"
HUB_PORT="27183"
NSS_NICKNAME="PRISM Local CA"
BLOCK_START="# >>> PRISM DEFAULT LLM PROXY >>>"
BLOCK_END="# <<< PRISM DEFAULT LLM PROXY <<<"

echo "[*] Setting up PRISM background services..."

if [ ! -f "$CA_PATH" ]; then
    echo "  ! No CA at $CA_PATH — run 'prism init --global' first." >&2
    exit 1
fi

# 1. Combined trust bundle: system roots first, PRISM CA appended.
build_bundle() {
    local sys=""
    for candidate in \
        /etc/ssl/certs/ca-certificates.crt \
        /etc/pki/tls/certs/ca-bundle.crt \
        /etc/ssl/ca-bundle.pem \
        /etc/ssl/cert.pem \
        /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
    do
        if [ -r "$candidate" ]; then sys="$candidate"; break; fi
    done
    if [ -z "$sys" ]; then
        echo "  ! No system CA bundle found; TLS verification will trust only PRISM." >&2
        cp "$CA_PATH" "$BUNDLE_PATH"
    else
        cat "$sys" "$CA_PATH" > "$BUNDLE_PATH"
        echo "  ✓ Trust bundle: $BUNDLE_PATH (system roots from $sys + PRISM CA)"
    fi
}
build_bundle

# 2. NSS trust for Chromium/Electron apps and Firefox profiles.
install_nss() {
    if ! command -v certutil > /dev/null 2>&1; then
        echo "  ! certutil not found — install libnss3-tools so Electron IDEs and"
        echo "    browsers trust the PRISM CA (otherwise they reject intercepted hosts)."
        return
    fi
    local count=0 db
    for db in $(prism_nss_dbs); do
        certutil -D -d "$db" -n "$NSS_NICKNAME" > /dev/null 2>&1 || true
        if certutil -A -d "$db" -n "$NSS_NICKNAME" -t "C,," -i "$CA_PATH" > /dev/null 2>&1; then
            count=$((count + 1))
        fi
    done
    echo "  ✓ NSS trust: $count database(s) updated"
}

prism_nss_dbs() {
    [ -d "$HOME/.pki/nssdb" ] && echo "sql:$HOME/.pki/nssdb"
    local prof
    for prof in "$HOME"/.mozilla/firefox/*/ "$HOME"/snap/firefox/common/.mozilla/firefox/*/; do
        [ -f "${prof}cert9.db" ] && echo "sql:${prof%/}"
    done
    return 0
}
install_nss

# 3. systemd user units for the proxy and MCP server.
mkdir -p "$HOME/.config/systemd/user"

cat << UNIT_PROXY > "$HOME/.config/systemd/user/prism-proxy.service"
[Unit]
Description=PRISM Transparent LLM MITM Proxy
After=network.target

[Service]
Type=simple
ExecStart=$HOME/.local/bin/prism serve --port $PORT
Restart=always
RestartSec=3
Environment=RUST_LOG=info
LimitNOFILE=65536

[Install]
WantedBy=default.target
UNIT_PROXY

cat << UNIT_MCP > "$HOME/.config/systemd/user/prism-mcp.service"
[Unit]
Description=PRISM Model Context Protocol (MCP) Server
After=network.target

[Service]
Type=simple
ExecStart=$HOME/.local/bin/prism mcp --port $MCP_PORT
Restart=always
RestartSec=3
Environment=RUST_LOG=info
LimitNOFILE=65536

[Install]
WantedBy=default.target
UNIT_MCP

systemctl --user daemon-reload
systemctl --user enable --now prism-proxy.service prism-mcp.service
echo "  ✓ Services: prism-proxy (:$PORT), prism-mcp (:$MCP_PORT)"

# 4. Clean up any legacy global environment.d proxy configuration
if [ -f "$ENV_FILE" ]; then
    rm -f "$ENV_FILE"
    echo "  ✓ Removed legacy global proxy from $ENV_FILE"
fi
systemctl --user unset-environment HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy 2>/dev/null || true

# 5. Safe shell rc configuration: exports PRISM_HUB_URL and aliases only, NEVER global proxy vars
PAYLOAD="
$BLOCK_START
# PRISM Environment
export PRISM_HUB_URL=\"http://127.0.0.1:$HUB_PORT\"

# PRISM Aliases
alias p=\"prism\"
alias prtk=\"prism cmd\"
alias pread=\"prism read\"
alias ptoon=\"prism toon\"
alias pcomp=\"prism compress\"
alias pgraph=\"prism graph\"
alias pcache=\"prism cache\"
alias pgain=\"prism gain\"
$BLOCK_END"

for RC in "$HOME/.bashrc" "$HOME/.profile"; do
    if [ -f "$RC" ]; then
        sed -i "/$BLOCK_START/,/$BLOCK_END/d" "$RC"
        echo "$PAYLOAD" >> "$RC"
        echo "  ✓ Updated $RC (safe aliases & hub url)"
    fi
done

cat << SUMMARY

==========================================================================
  [✓] PRISM background services active:
  - Proxy:        127.0.0.1:$PORT (systemd --user: prism-proxy)
  - MCP server:   127.0.0.1:$MCP_PORT (systemd --user: prism-mcp)
  - Trust bundle: $BUNDLE_PATH

  SAFETY GUARANTEE:
  Global HTTP_PROXY is NOT set across your laptop. Your IDEs (VS Code,
  Antigravity, Claude Code) and browser will never lose direct internet
  connectivity if PRISM is stopped or restarted.

  HOW TO USE THE PROXY:
  - Route a single command/tool through PRISM:
      prism proxy <cmd> [args...]
      (e.g. prism proxy claude)

  - Enable proxy for this terminal session:
      eval \$(prism proxy env)

  - Disable proxy in this terminal session:
      eval \$(prism proxy off)

  - Check proxy status:
      prism proxy status
==========================================================================
SUMMARY
